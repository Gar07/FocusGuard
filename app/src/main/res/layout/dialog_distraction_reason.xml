<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sesi Dijeda! Ponsel Terangkat"
        android:textColor="@color/sentry_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Sensor mendeteksi orientasi layar berbalik ke atas (Z > -5.0 m/s²). Pilih alasan mengapa Anda mengangkat ponsel:"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rgDistractionReasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <RadioButton
            android:id="@+id/rbReasonNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/focus_primary"
            android:checked="true"
            android:text="Cek Notifikasi Masuk (Chat / Email)"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbReasonSocial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/focus_primary"
            android:text="Impuls Membuka Media Sosial"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbReasonBored"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/focus_primary"
            android:text="Bosan / Lelah Belajar"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbReasonCall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/focus_primary"
            android:text="Panggilan Darurat / Keperluan Akademik"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </RadioGroup>

    <EditText
        android:id="@+id/etCustomReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_unselected"
        android:hint="Catatan tambahan (opsional)..."
        android:inputType="text"
        android:padding="10dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEndInterrupted"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_pill"
            android:text="Akhiri Sesi"
            android:textAllCaps="false"
            android:textColor="@color/alarm_crimson"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnResumeFocus"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_selected_focus"
            android:text="Simpan &amp; Lanjut"
            android:textAllCaps="false"
            android:textColor="@color/focus_primary"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
